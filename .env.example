# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el archivo .env con valores reales al repositorio.

# --- n8n ---
N8N_HOST=
N8N_API_KEY=
# URL con la que un flujo llama a otro dentro de la misma instancia n8n
# (los flujos Standard se encadenan entre sí vía webhooks internos).
N8N_INTERNAL_URL=http://localhost:5678

# --- Notificaciones (Basic) ---
ALERTS_FROM_EMAIL=
ALERTS_TO_EMAIL=

# --- Google Sheets (Basic) ---
# ID del documento (se obtiene de la URL de la hoja de cálculo)
GOOGLE_SHEETS_DOCUMENT_ID=
GOOGLE_SHEETS_CREDENTIALS=

# --- Nivel Standard: CRM ---
CRM_API_URL=
CRM_API_KEY=

# --- Nivel Standard: WhatsApp Business Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_OPERATOR_NUMBER=

# --- Nivel Standard/Premium: alertas de error centralizadas ---
SLACK_WEBHOOK_URL=

# --- Nivel Premium: base de datos ---
DATABASE_URL=

# --- Nivel Premium: integración custom (Flujo 5) ---
CUSTOM_API_URL=
CUSTOM_API_KEY=
