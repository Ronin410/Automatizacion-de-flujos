{
  "name": "[PREMIUM] 6 - Manejo de Errores Centralizado",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "error-alert-premium",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "bcbcbcb0-000b-4000-8000-000000000001",
      "name": "Webhook - Alerta de Error",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -20,
        260
      ],
      "webhookId": "error-alert-premium"
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "h1",
              "name": "mensaje_formateado",
              "type": "string",
              "value": "=⚠️ *Error en flujo automatizado (Premium)*\nFlujo: {{ $json.body.flujo }}\nNodo: {{ $json.body.nodo }}\nError: {{ $json.body.error }}\nDatos: {{ JSON.stringify($json.body.datos) }}\nHora: {{ $now.toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "bcbcbcb0-000b-4000-8000-000000000002",
      "name": "Formatear Alerta",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        200,
        260
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO error_log (flujo, nodo, mensaje, payload) VALUES ($1, $2, $3, $4::jsonb);",
        "options": {
          "queryReplacement": "={{ [ $('Webhook - Alerta de Error').item.json.body.flujo, $('Webhook - Alerta de Error').item.json.body.nodo, $('Webhook - Alerta de Error').item.json.body.error, JSON.stringify($('Webhook - Alerta de Error').item.json.body.datos || {}) ] }}"
        }
      },
      "id": "bcbcbcb0-000b-4000-8000-000000000003",
      "name": "Registrar Error en BD",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        420,
        260
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres - Cliente"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"text\": $('Formatear Alerta').item.json.mensaje_formateado } }}",
        "options": {}
      },
      "id": "bcbcbcb0-000b-4000-8000-000000000004",
      "name": "Notificar en Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        260
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.WHATSAPP_PHONE_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHATSAPP_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"messaging_product\": \"whatsapp\", \"to\": $env.WHATSAPP_OPERATOR_NUMBER, \"type\": \"text\", \"text\": { \"body\": $('Formatear Alerta').item.json.mensaje_formateado } } }}",
        "options": {}
      },
      "id": "bcbcbcb0-000b-4000-8000-000000000005",
      "name": "Notificar por WhatsApp (respaldo)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        860,
        360
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "WhatsApp Cloud API"
        }
      }
    }
  ],
  "connections": {
    "Webhook - Alerta de Error": {
      "main": [
        [
          {
            "node": "Formatear Alerta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Formatear Alerta": {
      "main": [
        [
          {
            "node": "Registrar Error en BD",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Registrar Error en BD": {
      "main": [
        [
          {
            "node": "Notificar en Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notificar en Slack": {
      "main": [
        [],
        [
          {
            "node": "Notificar por WhatsApp (respaldo)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "pinData": {},
  "versionId": "",
  "meta": {
    "templateNote": "Flujo 6 de 6 del nivel Premium — manejo de errores centralizado. A diferencia del nivel Standard, aquí además se deja registro en la tabla error_log de PostgreSQL (para el monitoreo de los 30 días de soporte, ver MANTENIMIENTO.md), y luego notifica por Slack con respaldo por WhatsApp."
  },
  "tags": [
    "premium",
    "errores",
    "postgres",
    "operaciones"
  ]
}
