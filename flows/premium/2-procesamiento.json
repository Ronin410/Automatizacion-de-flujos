{
  "name": "[PREMIUM] 2 - Procesamiento (scoring y deduplicación)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "procesamiento-premium",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "7e7e7e70-0007-4000-8000-000000000001",
      "name": "Webhook - Interno (desde Flujo 1)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -20,
        260
      ],
      "webhookId": "procesamiento-premium"
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "g1",
              "name": "score",
              "type": "number",
              "value": "={{ ($json.body.empresa ? 40 : 0) + ($json.body.telefono ? 30 : 0) + ($json.body.mensaje && $json.body.mensaje.length > 20 ? 30 : 10) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "7e7e7e70-0007-4000-8000-000000000002",
      "name": "Calcular Score",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        200,
        260
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE leads\nSET score = $1,\n    estado = CASE WHEN estado = 'nuevo' THEN 'calificado' ELSE estado END,\n    ultimo_contacto = now()\nWHERE id = $2\nRETURNING id, nombre, email, telefono, empresa, mensaje, score, estado;",
        "options": {
          "queryReplacement": "={{ [$json.score, $('Webhook - Interno (desde Flujo 1)').item.json.body.lead_id] }}"
        }
      },
      "id": "7e7e7e70-0007-4000-8000-000000000003",
      "name": "Actualizar Score en BD",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        420,
        260
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres - Cliente"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_INTERNAL_URL }}/webhook/notificacion-accion-premium",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"lead_id\": $json.id, \"nombre\": $json.nombre, \"email\": $json.email, \"telefono\": $json.telefono, \"empresa\": $json.empresa, \"mensaje\": $json.mensaje, \"score\": $json.score } }}",
        "options": {}
      },
      "id": "7e7e7e70-0007-4000-8000-000000000004",
      "name": "Disparar Flujo 3 (Notificación/Acción)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        160
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_INTERNAL_URL }}/webhook/error-alert-premium",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"flujo\": \"2 - Procesamiento\", \"nodo\": \"Actualizar Score en BD\", \"error\": $json.error?.message || 'Desconocido', \"datos\": $('Webhook - Interno (desde Flujo 1)').item.json.body } }}",
        "options": {}
      },
      "id": "7e7e7e70-0007-4000-8000-000000000005",
      "name": "Reportar Error a Flujo 6",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        360
      ],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Webhook - Interno (desde Flujo 1)": {
      "main": [
        [
          {
            "node": "Calcular Score",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calcular Score": {
      "main": [
        [
          {
            "node": "Actualizar Score en BD",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Actualizar Score en BD": {
      "main": [
        [
          {
            "node": "Disparar Flujo 3 (Notificación/Acción)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reportar Error a Flujo 6",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "pinData": {},
  "versionId": "",
  "meta": {
    "templateNote": "Flujo 2 de 6 del nivel Premium — capa de 'procesamiento'. Lo dispara el Flujo 1. Calcula un score simple (ajustar la regla al criterio real del cliente) y dispara el Flujo 3."
  },
  "tags": [
    "premium",
    "procesamiento",
    "postgres"
  ]
}
