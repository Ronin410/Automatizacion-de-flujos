{
  "name": "[PREMIUM] 4 - Seguimiento Programado",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "9a9a9a90-0009-4000-8000-000000000001",
      "name": "Cron - Diario 9am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -20,
        260
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, nombre, email, telefono, estado, ultimo_contacto\nFROM leads\nWHERE estado NOT IN ('cerrado', 'perdido')\n  AND (ultimo_contacto IS NULL OR ultimo_contacto < now() - interval '3 days')\nORDER BY score DESC\nLIMIT 50;",
        "options": {}
      },
      "id": "9a9a9a90-0009-4000-8000-000000000002",
      "name": "Buscar Leads sin Seguimiento",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        200,
        260
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres - Cliente"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.WHATSAPP_PHONE_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHATSAPP_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"messaging_product\": \"whatsapp\", \"to\": $json.telefono, \"type\": \"text\", \"text\": { \"body\": \"Hola \" + $json.nombre + \", seguimos disponibles para ayudarte. ¿Te gustaría continuar la conversación?\" } } }}",
        "options": {}
      },
      "id": "9a9a9a90-0009-4000-8000-000000000003",
      "name": "Enviar Seguimiento (WhatsApp)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        160
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "WhatsApp Cloud API"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE leads SET ultimo_contacto = now(), estado = 'contactado', interacciones = interacciones + 1 WHERE id = $1;\nINSERT INTO seguimiento (lead_id, tipo, nota) VALUES ($1, 'whatsapp', 'Seguimiento automático programado');",
        "options": {
          "queryReplacement": "={{ [$('Buscar Leads sin Seguimiento').item.json.id] }}"
        }
      },
      "id": "9a9a9a90-0009-4000-8000-000000000004",
      "name": "Registrar Seguimiento en BD",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        640,
        160
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres - Cliente"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_INTERNAL_URL }}/webhook/error-alert-premium",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"flujo\": \"4 - Seguimiento Programado\", \"nodo\": \"Buscar/Enviar Seguimiento\", \"error\": $json.error?.message || 'Desconocido', \"datos\": $json }}}",
        "options": {}
      },
      "id": "9a9a9a90-0009-4000-8000-000000000005",
      "name": "Reportar Error a Flujo 6",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        360
      ],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Cron - Diario 9am": {
      "main": [
        [
          {
            "node": "Buscar Leads sin Seguimiento",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar Leads sin Seguimiento": {
      "main": [
        [
          {
            "node": "Enviar Seguimiento (WhatsApp)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reportar Error a Flujo 6",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar Seguimiento (WhatsApp)": {
      "main": [
        [
          {
            "node": "Registrar Seguimiento en BD",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reportar Error a Flujo 6",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "pinData": {},
  "versionId": "",
  "meta": {
    "templateNote": "Flujo 4 de 6 del nivel Premium — seguimiento automático de leads sin contacto reciente (3+ días), corre una vez al día. n8n itera automáticamente sobre cada fila que devuelve el nodo Postgres."
  },
  "tags": [
    "premium",
    "seguimiento",
    "postgres"
  ]
}
