{
  "name": "[STANDARD] 1 - Captura de Lead → CRM",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-standard",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "3a3a3a30-0003-4000-8000-000000000001",
      "name": "Webhook - Recibir Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -20,
        260
      ],
      "webhookId": "lead-standard"
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "nombre",
              "type": "string",
              "value": "={{ $json.body.nombre?.trim() || '' }}"
            },
            {
              "id": "b2",
              "name": "email",
              "type": "string",
              "value": "={{ ($json.body.email || '').trim().toLowerCase() }}"
            },
            {
              "id": "b3",
              "name": "telefono",
              "type": "string",
              "value": "={{ $json.body.telefono?.trim() || '' }}"
            },
            {
              "id": "b4",
              "name": "empresa",
              "type": "string",
              "value": "={{ $json.body.empresa?.trim() || '' }}"
            },
            {
              "id": "b5",
              "name": "mensaje",
              "type": "string",
              "value": "={{ $json.body.mensaje?.trim() || '' }}"
            },
            {
              "id": "b6",
              "name": "origen",
              "type": "string",
              "value": "={{ $json.body.origen || 'sitio-web' }}"
            },
            {
              "id": "b7",
              "name": "fecha_recepcion",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "3a3a3a30-0003-4000-8000-000000000002",
      "name": "Normalizar Datos",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        200,
        260
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.nombre }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.email }}",
              "rightValue": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3a3a3a30-0003-4000-8000-000000000003",
      "name": "Validar Datos",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        420,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_API_URL }}/leads",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.CRM_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"nombre\": $json.nombre, \"email\": $json.email, \"telefono\": $json.telefono, \"empresa\": $json.empresa, \"mensaje\": $json.mensaje, \"origen\": $json.origen } }}",
        "options": {}
      },
      "id": "3a3a3a30-0003-4000-8000-000000000004",
      "name": "Crear Lead en CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        160
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "CRM - Cliente"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_INTERNAL_URL }}/webhook/whatsapp-notify-standard",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"nombre\": $('Normalizar Datos').item.json.nombre, \"email\": $('Normalizar Datos').item.json.email, \"telefono\": $('Normalizar Datos').item.json.telefono, \"empresa\": $('Normalizar Datos').item.json.empresa, \"mensaje\": $('Normalizar Datos').item.json.mensaje } }}",
        "options": {}
      },
      "id": "3a3a3a30-0003-4000-8000-000000000005",
      "name": "Disparar Flujo 2 (WhatsApp)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        860,
        60
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": true, \"mensaje\": \"Lead recibido y registrado.\" } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "3a3a3a30-0003-4000-8000-000000000006",
      "name": "Responder OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1080,
        60
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_INTERNAL_URL }}/webhook/error-alert-standard",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"flujo\": \"1 - Captura de Lead → CRM\", \"nodo\": \"Crear Lead en CRM\", \"error\": $json.error?.message || 'Desconocido', \"datos\": $('Normalizar Datos').item.json } }}",
        "options": {}
      },
      "id": "3a3a3a30-0003-4000-8000-000000000007",
      "name": "Reportar Error a Flujo 3",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        860,
        320
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": false, \"mensaje\": \"Ocurrió un error, ya fue reportado. Intenta de nuevo más tarde.\" } }}",
        "options": {
          "responseCode": 500
        }
      },
      "id": "3a3a3a30-0003-4000-8000-000000000008",
      "name": "Responder Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1080,
        320
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": false, \"mensaje\": \"Faltan datos requeridos (nombre o email válido).\" } }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "3a3a3a30-0003-4000-8000-000000000009",
      "name": "Responder Datos Inválidos",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        420,
        460
      ]
    }
  ],
  "connections": {
    "Webhook - Recibir Lead": {
      "main": [
        [
          {
            "node": "Normalizar Datos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalizar Datos": {
      "main": [
        [
          {
            "node": "Validar Datos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validar Datos": {
      "main": [
        [
          {
            "node": "Crear Lead en CRM",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Responder Datos Inválidos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Crear Lead en CRM": {
      "main": [
        [
          {
            "node": "Disparar Flujo 2 (WhatsApp)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reportar Error a Flujo 3",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Disparar Flujo 2 (WhatsApp)": {
      "main": [
        [
          {
            "node": "Responder OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reportar Error a Flujo 3": {
      "main": [
        [
          {
            "node": "Responder Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "pinData": {},
  "versionId": "",
  "meta": {
    "templateNote": "Flujo 1 de 3 del nivel Standard. Dispara el Flujo 2 (WhatsApp) llamando a su webhook interno, y reporta errores al Flujo 3 (manejo centralizado) de la misma forma. Ajustar CRM_API_URL/CRM_API_KEY al CRM real del cliente."
  },
  "tags": [
    "standard",
    "leads",
    "crm"
  ]
}
